{
  "name": "royal-match-clone",
  "version": "0.1.0",
  "private": true,
  "description": "A Royal Match-style match-3 game built with PlayCanvas engine + React. Features 1000 levels with escalating difficulty (every 3rd = Hard, every 6th = Super Hard).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --fix --ignore-path .eslintignore",
    "lint:check": "eslint src --ignore-path .eslintignore",
    "typecheck": "tsc --noEmit",
    "generate:levels": "ts-node --project tsconfig.scripts.json scripts/generate-levels.ts",
    "generate:levels:watch": "ts-node --project tsconfig.scripts.json scripts/generate-levels.ts --watch",
    "validate:levels": "ts-node --project tsconfig.scripts.json scripts/validate-levels.ts"
  },
  "dependencies": {
    "playcanvas": "^2.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/ui": "^2.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.0",
    "globals": "^15.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.17.0",
    "vite": "^5.4.0",
    "vite-plugin-svgr": "^5.0.0",
    "vitest": "^2.1.0"
  }
}
